    faamprop:sections """<h3>List of compositions</h3>
<ul>
<li> Missa, P.Benoit </li>
<li> Messe Solenne, C.M. Weber</li>
<li> Missa Op.92, F. Lachner</li>
<li> Tantum Ergo, Haydn</li>
<li> Tantum Ergo ou Genitori, François Riga</li>
<li> Three Easy Litanies, Lodovico Martini</li>
<li> Ave maris stella, P. Benoit</li>
<li> O gloriosa virginum, P. Benoit</li>
<li> Ecce Panis, Marina (?)</li>
<li> Suscipe de Saint Jgnace, Felix Aerts</li>
<li> Au Choeur de Jésus, Edmond Waucampt</li>
<li> Jesu dulcis memoria, Fr. Riga</li>
<li> Ave maris stella, Lodovico Martini</li>
<li> Ave maris stella, I. Eykens</li>
<li> Ave Maria, L. Husson</li>
<li> Salve Regina, P. Benoit</li>
<li> Ave Regina, P. Benoit</li>
<li> Ave Maria, G.B. Pergolesi (?)</li>
<li> Ave Maria, J. Faure</li>
<li> Ave Maria, F. Everaerts</li>
<li> Ave maris stella, F. Benoist</li>
<li> Ave verum, Balthasar Florence</li>
<li> O Salutaris Op.39 N.2, Adolphe F. Wouters</li>
</ul>"""^^rdf:HTML ;
