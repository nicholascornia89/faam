    faamprop:score_complexity faamentity:WJHHh56W ;
    faamprop:score_format faamentity:XyayZhMR ;
    faamprop:sections """<ol>
<li> Wer Dank opfert, der preiset mich </li>
<li> Wo soll ich fliehen hin</li>
<li> Wie schön leuchtet der Morgenstern</li>
<li> Herr, ween die stolzen Feinde schnauben</li>
<li> Liebster Gott, wenn werd ich sterben?</li>
<li> Fallt mit Danken, fallt mit Loben</li>
<li> Ich hatte viel Bekümmernis</li>
<li> Schwingt freudig euch empor</li>
<li> Ach wie flüchtig, ach wie nichtig</li>
</ol>"""^^rdf:HTML ;
